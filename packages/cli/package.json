{
	"name": "@oc-framework/cli",
	"version": "0.1.0",
	"description": "CLI for OpenComponents — develop, package, publish and validate components",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"oc": "./dist/oc-cli.js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/opencomponents/oc.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/opencomponents/oc/issues"
	},
	"homepage": "https://github.com/opencomponents/oc/tree/master/packages/cli#readme",
	"keywords": ["oc", "opencomponents", "cli"],
	"author": "Matteo Figus",
	"license": "MIT",
	"files": ["dist"],
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "npm run lint && tsc",
		"lint": "npx @biomejs/biome check src",
		"lint:apply": "npx @biomejs/biome check --write src",
		"test": "echo \"no tests yet\" && exit 0",
		"test-silent": "npm run test --silent"
	},
	"dependencies": {
		"yargs": "^17.7.2",
		"semver": "^7.8.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/node": "^25.9.3",
		"@types/semver": "^7.7.1",
		"@types/yargs": "^17.0.35",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3"
	}
}
