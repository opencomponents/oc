{
	"name": "@oc-framework/cli",
	"version": "0.50.64",
	"description": "CLI for OpenComponents \u2014 develop, package, publish and validate components",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"oc": "./dist/oc-cli.js"
	},
	"repository": {
