{
	"name": "@oc-framework/registry",
	"version": "0.50.64",
	"description": "Registry runtime for OpenComponents \u2014 serve and publish components",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/opencomponents/oc.git",
		"directory": "packages/registry"
	},
	"bugs": {
		"url": "https://github.com/opencomponents/oc/issues"
	},
	"homepage": "https://github.com/opencomponents/oc/tree/master/packages/registry#readme",
	"keywords": [
		"oc",
		"opencomponents",
		"registry"
	],
	"author": "Matteo Figus",
	"license": "MIT",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "npm run lint && tsc && node tasks/build.js",
		"lint": "npx @biomejs/biome check src preview",
		"lint:apply": "npx @biomejs/biome check --write src preview",
		"preview": "bun run preview/uiPreview.ts",
		"test": "echo \"no tests yet\" && exit 0",
		"test-silent": "npm run test --silent",
		"bench": "node tasks/benchmarks/server-benchmark.js --repetitions=5",
		"bench:burst": "node tasks/benchmarks/single-flight-burst.js",
		"bench:quick": "node tasks/benchmarks/server-benchmark.js --repetitions=3",
		"bench:update-baseline": "node tasks/benchmarks/server-benchmark.js --repetitions=5 --update-baseline=true",
		"bench:high-load": "node tasks/benchmarks/server-benchmark.js --scenarios=high-load-local,high-load-storage --high-load-repetitions=3"
	},
	"dependencies": {
		"@oc-framework/core": "^0.1.0",
		"@kitajs/html": "^4.2.13",
		"@rdevis/turbo-stream": "^2.4.1",
		"basic-auth-connect": "^1.1.0",
		"cookie-parser": "^1.4.7",
		"dotenv": "^17.4.2",
		"errorhandler": "^1.5.2",
		"express": "^5.2.1",
		"fs-extra": "^11.3.5",
		"morgan": "^1.12.1",
		"multer": "^2.5.0",
		"oc-client": "^4.0.4",
		"oc-client-browser": "^2.1.12",
		"oc-empty-response-handler": "^1.0.2",
		"oc-metadata-adapters-utils": "^0.1.1",
		"oc-s3-storage-adapter": "^2.2.5",
		"oc-storage-adapters-utils": "^2.1.3",
		"oc-template-es6": "^2.0.0",
		"oc-template-es6-compiler": "^7.1.4",
		"oc-template-handlebars": "^6.0.26",
		"oc-template-handlebars-compiler": "^6.7.1",
		"oc-template-jade": "^7.0.6",
		"oc-template-jade-compiler": "^7.5.0",
		"response-time": "^2.3.4",
		"semver": "^7.8.4",
		"source-map": "^0.7.6",
		"undici": "^8.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@kitajs/ts-html-plugin": "^4.1.4",
		"@types/cookie-parser": "^1.4.10",
		"@types/errorhandler": "^1.5.3",
		"@types/express": "^5.0.6",
		"@types/fs-extra": "^11.0.4",
		"@types/lodash.isequal": "^4.5.8",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.1.0",
		"@types/node": "^25.9.3",
		"@types/response-time": "^2.3.9",
		"@types/semver": "^7.7.1",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"@oc-framework/cli": "^0.50.64"
	}
}
